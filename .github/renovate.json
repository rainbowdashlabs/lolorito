{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rainbowdashlabs/rainbowdashlabs"],
  "baseBranchPatterns": ["main"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Resolve Maven artifacts through the eldonexus Maven Central proxy to avoid Central rate limits",
      "matchDatasources": ["maven"],
      "registryUrls": [
        "https://eldonexus.de/repository/maven-central",
        "https://eldonexus.de/repository/maven-public"
      ]
    },
    {
      "description": "Hold TypeScript below 7 until vue-tsc supports the native compiler",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
