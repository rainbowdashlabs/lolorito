{
  "name": "lolorito-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && npm run lint && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint:conventions": "node scripts/lint-conventions.mjs",
    "lint:imports": "node scripts/lint-imports.mjs",
    "lint:style": "node scripts/lint-style.mjs",
    "lint:component-size": "node scripts/lint-component-size.mjs",
    "lint:duplication": "node scripts/lint-duplication.mjs",
    "lint": "npm run lint:icons && npm run lint:conventions && npm run lint:imports && npm run lint:style && npm run lint:component-size && npm run lint:duplication",
    "test:visual": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work -e CI mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "test:visual:update": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.16.0",
    "echarts": "^6.1.0",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  }
}
